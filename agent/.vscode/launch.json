{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 llm.py（Python Debugger）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "args": ["用一句话解释什么是递归"]
    },
    {
      "name": "运行 llm.py（旧版 python 扩展）",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "args": ["用一句话解释什么是递归"]
    }
  ]
}
