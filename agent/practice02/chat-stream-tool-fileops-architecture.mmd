    classDef cfg fill:#F1F1F1,stroke:#8A8A8A,stroke-width:1.5px,color:#242424
    classDef startup fill:#E8F1FF,stroke:#4C7FD1,stroke-width:1.5px,color:#10233F
    classDef ui fill:#FFF4E2,stroke:#D08A2C,stroke-width:1.5px,color:#3A2A10
    classDef orch fill:#FDEDE4,stroke:#C4663B,stroke-width:1.5px,color:#3A1E10
    classDef model fill:#E9F7EA,stroke:#3E9B4F,stroke-width:1.5px,color:#10321A
    classDef bridge fill:#F2ECFF,stroke:#7C5CC4,stroke-width:1.5px,color:#221541
    classDef mcp fill:#FFECEF,stroke:#C4455C,stroke-width:1.5px,color:#3D121A
    classDef tool fill:#E6F7F8,stroke:#2F8F96,stroke-width:1.5px,color:#0E2E31
    classDef api fill:#DFF3FF,stroke:#2C7FA8,stroke-width:2px,color:#0B2C3D
    classDef res fill:#FBE9E7,stroke:#B0564A,stroke-width:1.5px,color:#331713

    class F1,F2 cfg
    class P1,P2,P3 startup
    class U1,U2,U3 ui
    class O1,O2,O3 orch
    class M1,M2,M3 model
    class B1,B2 bridge
    class C2,S1N,S2N mcp
    class T1,T2,T3 tool
    class API api
    class RES res
    class LOOP orch
